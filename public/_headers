# Cache policy for static hosts that read _headers (Cloudflare Pages, Netlify).
#
# The default on Cloudflare Pages is `max-age=0, must-revalidate` for EVERY
# file, including content-hashed bundles — so each page load revalidates ~20
# chunks over the network. On a phone that is both slow and a reliability
# problem: every extra round trip is another chance for a chunk to fail.
#
# Vite fingerprints everything under /assets/ (name-<contenthash>.js), so those
# URLs are immutable by construction — a changed file gets a new URL. Cache
# them hard. Everything unhashed (the HTML shell, the service worker, the
# manifest) must revalidate every time, otherwise a browser can keep serving an
# index.html that points at chunk hashes a later deploy has already removed.

# Caveat: when the SPA catch-all in _redirects answers a request for a deleted
# chunk with index.html, that HTML body picks up this immutable header too. It
# is harmless in practice — that URL belongs to a build that no longer exists,
# and the recovery reload moves the client onto freshly hashed URLs it will
# never request again.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The app shell — never cache. This is the file that decides which chunk
# hashes the browser asks for, so a stale copy here is what strands a client on
# a build that no longer exists.
/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Service worker + PWA metadata: a stale sw.js can never hand over to a new
# one, which would pin a device to an old build indefinitely.
/sw.js
  Cache-Control: public, max-age=0, must-revalidate

/manifest.webmanifest
  Cache-Control: public, max-age=0, must-revalidate
